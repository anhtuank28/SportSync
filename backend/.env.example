# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/sportsync_db?schema=public"

# Redis Connection (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL="redis://:redispassword@localhost:6379"

# Security & JWT
JWT_SECRET=sportsync_super_secret_jwt_key_2026_enterprise_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=sportsync_refresh_token_secret_key_2026
REFRESH_TOKEN_EXPIRES_IN=30d

# VietQR / PayOS Payment Config
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=0912345678
VIETQR_ACCOUNT_NAME=SPORTSYNC HANOI
VIETQR_WEBHOOK_SECRET=vietqr_webhook_secret_key_8902

# Redis Hold Lock TTL (in seconds)
BOOKING_HOLD_TTL_SECONDS=600
